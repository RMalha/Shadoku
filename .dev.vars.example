# Copy to .dev.vars (git-ignored) for `npm run dev:cf`. In production set the same names with
#   npx wrangler pages secret put NAME --project-name shadoku
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# SITE_URL=https://shadoku.net
# The Android app's browser build calling this backend (localhost and Pages previews only; production allows https://app.shadoku.net and nothing else):
# APP_DEV_ORIGINS=http://localhost:5183
# Test sign-ins, localhost only (/api/auth/dev/login and POST /api/app/auth/dev):
# DEV_LOGIN=1
