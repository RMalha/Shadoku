# Cloudflare Pages response headers.
# Every page: HTTPS only (HSTS), no framing by other sites, no MIME sniffing, a short Referer, and no powerful browser features.
# The Content-Security-Policy is in REPORT-ONLY mode first: the browser lists what it would block in the console without blocking it.
# Open the site (home, a case, the Workshop, sign-in, the share button) with the console open; when it stays clean, rename the header
# to Content-Security-Policy. Violations also go to /api/report (kind "error") only if you add a report-uri; none is set on purpose.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://lh3.googleusercontent.com https://avatars.githubusercontent.com; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com https://github.com; frame-ancestors 'self'
# The service worker and the manifest must never be served stale: browsers check them for updates on every visit.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
# Android's Digital Asset Links check: always fresh JSON, so a changed key takes effect at once.
/.well-known/assetlinks.json
  Cache-Control: no-cache
  Content-Type: application/json
# Vite's hashed bundles never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
