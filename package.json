{
  "name": "shadoku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync": "node scripts/sync-puzzles.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "check:i18n": "node scripts/check-locales.mjs",
    "test:case-text": "node scripts/test-case-text.mjs",
    "test:hardening": "node scripts/test-hardening.mjs",
    "test": "npm run check:i18n && npm run test:hardening && npm run test:case-text",
    "ci": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "dev:cf": "vite build && wrangler pages dev dist",
    "deploy": "vite build && wrangler pages deploy dist --project-name shadoku"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "wrangler": "^4.0.0"
  }
}
