{
  // i18n Ally: src/locales/<lang>.json, flat dotted keys (ATOM.ROOM, PROP.RUG.noun ...).
  // en.json is generated by `python engine/shadoku_engine.py --locale-en`; edit the engine, not en.json.
  "i18n-ally.localesPaths": ["src/locales"],
  "i18n-ally.pathMatcher": "{locale}.json",
  "i18n-ally.enabledParsers": ["json"],
  "i18n-ally.keystyle": "flat",
  "i18n-ally.sourceLanguage": "en",
  "i18n-ally.displayLanguage": "pt-PT",
  "i18n-ally.enabledFrameworks": ["general"],
  "i18n-ally.keepFulfilled": false,
  "i18n-ally.sortKeys": false,
  "i18n-ally.translate.engines": ["google", "google-cn"],
  "i18n-ally.translate.deepl.useFreeApiHost": true
}