 "tutorialLore": [
  {
   "title": "The Illusion of Justice",
   "text": "Ah, S. H. Adow, new blood. The inspector has scribbled scapegoats across the board, a parlour trick we have been feeding him for centuries.",
   "titleKey": "LORE.tutorial.1.TITLE",
   "textKey": "LORE.tutorial.1.TEXT"
  },
  {
   "title": "The Ray Block",
   "text": "Astrid sat on a stool, and the Kitchen has two, side by side. Whichever she took, her gaze runs down the same row and through the door: that line is lit before we even know her seat.",
   "titleKey": "LORE.tutorial.2.TITLE",
   "textKey": "LORE.tutorial.2.TEXT"
  },
  {
   "title": "The Geometry of Panic",
   "text": "Watch their eyes. Daphne stood beside the safe, and Astrid's row already lights one side of it, so she must take the other. The safe stands between them, and neither sees the other.",
   "titleKey": "LORE.tutorial.3.TITLE",
   "textKey": "LORE.tutorial.3.TEXT"
  },
  {
   "title": "The Sanctuary",
   "text": "Here is the masterstroke: every tile is lit but one. That single void in their vision is your sanctuary. Step into the shadows.",
   "titleKey": "LORE.tutorial.4.TITLE",
   "textKey": "LORE.tutorial.4.TEXT"
  }
 ]
}
