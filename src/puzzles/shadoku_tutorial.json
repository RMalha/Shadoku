 "tutorialLore": [
  {
   "title": "The Illusion of Justice",
   "text": "Ah, S. H. Adow, new blood. The inspector scribbled scapegoats on the board, a parlour trick we feed him for centuries.",
   "titleKey": "LORE.tutorial.1.TITLE",
   "textKey": "LORE.tutorial.1.TEXT"
  },
  {
   "title": "The Ray Block",
   "text": "Aurora sat on a stool, and the Kitchen has two. Whichever she took, her gaze runs through the opening: that line is lit either way.",
   "titleKey": "LORE.tutorial.2.TITLE",
   "textKey": "LORE.tutorial.2.TEXT"
  },
  {
   "title": "The Geometry of Panic",
   "text": "Dinah stood beside the safe. Aurora's row lights one side of it, so she takes the other: the safe blocks their view.",
   "titleKey": "LORE.tutorial.3.TITLE",
   "textKey": "LORE.tutorial.3.TEXT"
  },
  {
   "title": "The Sanctuary",
   "text": "Every tile is lit but one. That single void in their vision is your sanctuary. Step into the shadows.",
   "titleKey": "LORE.tutorial.4.TITLE",
   "textKey": "LORE.tutorial.4.TEXT"
  }
